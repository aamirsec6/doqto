{
  "name": "doqto",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "node server/start.mjs",
    "start:web": "next start",
    "start:realtime": "node server/realtime.mjs",
    "lint": "eslint",
    "dev:realtime": "node server/realtime.mjs",
    "dev:all": "concurrently -k -n next,rt -c cyan,magenta \"next dev\" \"node server/realtime.mjs\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.4",
    "dotenv": "^17.4.2",
    "jose": "^6.2.9",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vercel": "^54.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
